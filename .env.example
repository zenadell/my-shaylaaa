# Turso Database Configuration
# Get these from the Turso CLI or dashboard: https://turso.tech/
TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Cloudinary Storage Configuration
# Get these from your Cloudinary dashboard: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# API Configuration
PORT=3001
NODE_ENV=development
# Set this to your production backend URL once deployed (e.g., https://your-server.onrender.com)
API_URL=http://localhost:3001
